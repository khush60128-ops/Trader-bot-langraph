# ── LLM (Google Gemini) ────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here

# ── Search (Tavily) ───────────────────────────────────────────────────────────
TAVILY_API_KEY=your_tavily_api_key_here

# ── Broker (Mudrex) ───────────────────────────────────────────────────────────
MUDREX_API_SECRET=your_mudrex_api_secret_here
